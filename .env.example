# Copy to .env (never commit .env)

# --- LLM ---
ANTHROPIC_API_KEY=
LLM_MODEL=anthropic:claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=high
LLM_MAX_TOKENS=64000

# --- App ---
ENVIRONMENT=dev
CORS_ORIGINS=["http://localhost:5173"]

# --- Database (local Docker) ---
# Local-only passwords: generate your own, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# and keep the URLs below in sync with them. The URLs use 127.0.0.1, not localhost:
# the port is published on 127.0.0.1 only, and "localhost" first tries ::1 (5 s timeout).
POSTGRES_PORT=5433
POSTGRES_PASSWORD=change-me-superuser
FORGE_OWNER_PASSWORD=change-me-owner
FORGE_APP_PASSWORD=change-me-app
DATABASE_URL=postgresql+psycopg://forge_app:change-me-app@127.0.0.1:5433/forge
DATABASE_OWNER_URL=postgresql+psycopg://forge_owner:change-me-owner@127.0.0.1:5433/forge
TEST_DATABASE_URL=postgresql+psycopg://forge_app:change-me-app@127.0.0.1:5433/forge_test
TEST_DATABASE_OWNER_URL=postgresql+psycopg://forge_owner:change-me-owner@127.0.0.1:5433/forge_test

# --- Google sign-in (OAuth client "Web application" in Google Cloud console) ---
# Authorized redirect URI to declare at Google: http://localhost:5173/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/callback
APP_BASE_URL=http://localhost:5173
# Tolerated drift (seconds, 0-300) between Google's clock and ours on the ID token's iat/exp.
OIDC_CLOCK_SKEW_SECONDS=60

# --- Sessions & invitations ---
# Local http only: keep COOKIE_SECURE=true anywhere else (refused with ENVIRONMENT=prod).
COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT_HOURS=24
SESSION_MAX_AGE_DAYS=7
INVITATION_TTL_DAYS=7
LOGIN_REQUEST_TTL_MINUTES=10

# --- Tracing LangSmith (optional) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=forge
